{% macro govukPublishingBackToTop(params) %}
<div class="gem-c-back-to-top govuk-!-display-none-print{% if params.classes %} {{ params.classes }}{% endif %}">
  <a class="govuk-link gem-c-back-to-top__link" href="{{ params.href | default('#contents') }}">
    <svg class="gem-c-back-to-top__icon" xmlns="http://www.w3.org/2000/svg" width="13" height="17" viewBox="0 0 13 17" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M6.5 0L0 6.5 1.4 8l4-4v12.7h2V4l4.3 4L13 6.4z"/>
    </svg>
    {{ params.text | default('Contents') }}
  </a>
</div>
{% endmacro %}